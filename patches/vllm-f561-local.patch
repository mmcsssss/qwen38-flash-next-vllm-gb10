+def _parse_cpu_affinity(value: str) -> set[int]:
+    """Parse Linux CPU-list syntax such as ``5-9,15-19``."""
+    cpus: set[int] = set()
+    for item in value.split(","):
+        item = item.strip()
+        if not item:
+            continue
+        if "-" not in item:
+            cpus.add(int(item))
+            continue
+        start_text, end_text = item.split("-", 1)
+        start = int(start_text)
+        end = int(end_text)
+        if end < start:
+            raise ValueError(f"Invalid descending CPU range: {item}")
+        cpus.update(range(start, end + 1))
+    if not cpus:
+        raise ValueError("CPU affinity list is empty")
+    return cpus
+

@@ -0,0 +1,417 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""SSD-backed safetensors row lookup for large PLE embedding tables."""
+
+import json
+import mmap
+import os
+import struct
+from collections.abc import Callable
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import torch
+from torch import nn
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_SAFETENSORS_INDEX = "model.safetensors.index.json"
+_FP8_DTYPE = "F8_E4M3"
+
+
+@dataclass(frozen=True)
+class _ShardMetadata:
+    index: int
+    checkpoint_name: str
+    file_path: Path
+    data_offset: int
+    rows: int
+    width: int
+
+
+class _MappedSafetensorsFile:
+    """One private, file-backed mmap shared by every tensor in a shard file."""
+
+    def __init__(self, path: Path) -> None:
+        self.path = path
+        self._file = path.open("rb")
+        self.mapping = mmap.mmap(self._file.fileno(), 0, access=mmap.ACCESS_COPY)
+        if hasattr(self.mapping, "madvise") and hasattr(mmap, "MADV_RANDOM"):
+            self.mapping.madvise(mmap.MADV_RANDOM)
+
+    def byte_tensor(self, offset: int, length: int) -> tuple[memoryview, torch.Tensor]:
+        view = memoryview(self.mapping)[offset : offset + length]
+        tensor = torch.frombuffer(view, dtype=torch.uint8)
+        return view, tensor
+
+    def drop_cache(self) -> None:
+        if hasattr(self.mapping, "madvise") and hasattr(mmap, "MADV_DONTNEED"):
+            self.mapping.madvise(mmap.MADV_DONTNEED)
+
+    def drop_cache_ranges(self, ranges: list[tuple[int, int]]) -> None:
+        """Discard only pages touched by small random row lookups."""
+        if (
+            not ranges
+            or not hasattr(self.mapping, "madvise")
+            or not hasattr(mmap, "MADV_DONTNEED")
+        ):
+            return
+
+        page_size = mmap.PAGESIZE
+        mapped_size = len(self.mapping)
+        page_ranges = sorted(
+            {
+                (
+                    (offset // page_size) * page_size,
+                    min(
+                        ((offset + length + page_size - 1) // page_size) * page_size,
+                        mapped_size,
+                    ),
+                )
+                for offset, length in ranges
+            }
+        )
+        merged: list[tuple[int, int]] = []
+        for start, end in page_ranges:
+            if not merged or start > merged[-1][1]:
+                merged.append((start, end))
+            else:
+                merged[-1] = (merged[-1][0], max(merged[-1][1], end))
+        for start, end in merged:
+            if end > start:
+                self.mapping.madvise(mmap.MADV_DONTNEED, start, end - start)
+
+
+def _read_safetensors_header(path: Path) -> tuple[int, dict[str, Any]]:
+    with path.open("rb") as file:
+        raw_length = file.read(8)
+        if len(raw_length) != 8:
+            raise ValueError(f"Invalid safetensors header in {path}")
+        header_length = struct.unpack("<Q", raw_length)[0]
+        if header_length <= 0 or header_length > path.stat().st_size - 8:
+            raise ValueError(
+                f"Invalid safetensors header length {header_length} in {path}"
+            )
+        raw_header = file.read(header_length)
+    try:
+        header = json.loads(raw_header)
+    except (TypeError, ValueError) as error:
+        raise ValueError(f"Invalid safetensors JSON header in {path}") from error
+    if not isinstance(header, dict):
+        raise ValueError(f"Safetensors header in {path} is not an object")
+    return 8 + header_length, header
+
+
+class SafetensorsPleStore:
+    """Map checkpoint PLE shards without copying their complete contents to RAM."""
+
+    def __init__(
+        self,
+        checkpoint_dir: str | os.PathLike[str],
+        layer_prefix: str,
+        *,
+        expected_parts: int,
+        expected_vocab_size: int,
+        expected_width: int,
+        name_mapper: Callable[[str], str | None] | None = None,
+        drop_cache: bool = False,
+    ) -> None:
+        self.checkpoint_dir = Path(checkpoint_dir)
+        self.layer_prefix = layer_prefix
+        self.expected_parts = expected_parts
+        self.expected_vocab_size = expected_vocab_size
+        self.embedding_dim = expected_width
+        self.dtype = torch.float8_e4m3fn
+        self.drop_cache_after_lookup = drop_cache
+
+        if expected_parts <= 0:
+            raise ValueError("PLE SSD shard count must be positive")
+        if expected_vocab_size <= 0 or expected_width <= 0:
+            raise ValueError("PLE SSD table dimensions must be positive")
+
+        shards = self._discover_shards(name_mapper)
+        self.rows_per_shard = (expected_vocab_size + expected_parts - 1) // expected_parts
+        self._files: dict[Path, _MappedSafetensorsFile] = {}
+        self._views: list[memoryview] = []
+        self._tables: list[torch.Tensor] = []
+        self._table_file_paths: list[Path] = []
+        self._table_data_offsets: list[int] = []
+
+        for shard in shards:
+            mapped_file = self._files.get(shard.file_path)
+            if mapped_file is None:
+                mapped_file = _MappedSafetensorsFile(shard.file_path)
+                self._files[shard.file_path] = mapped_file
+            byte_length = shard.rows * shard.width
+            view, raw_table = mapped_file.byte_tensor(shard.data_offset, byte_length)
+            self._views.append(view)
+            self._tables.append(raw_table.reshape(shard.rows, shard.width))
+            self._table_file_paths.append(shard.file_path)
+            self._table_data_offsets.append(shard.data_offset)
+
+        self.mapped_bytes = sum(table.numel() for table in self._tables)
+        logger.info(
+            "Mapped %d PLE shard(s) from %d safetensors file(s): %.2f GiB "
+            "file-backed, no full-table RAM allocation",
+            len(self._tables),
+            len(self._files),
+            self.mapped_bytes / 1024**3,
+        )
+
+    def _discover_shards(
+        self,
+        name_mapper: Callable[[str], str | None] | None,
+    ) -> list[_ShardMetadata]:
+        index_path = self.checkpoint_dir / _SAFETENSORS_INDEX
+        if not index_path.is_file():
+            raise FileNotFoundError(
+                f"PLE SSD offload requires {index_path}; checkpoint is incomplete "
+                "or does not use an indexed safetensors layout"
+            )
+        with index_path.open(encoding="utf-8") as file:
+            index = json.load(file)
+        weight_map = index.get("weight_map")
+        if not isinstance(weight_map, dict):
+            raise ValueError(f"Invalid weight_map in {index_path}")
+
+        shard_prefix = f"{self.layer_prefix}.ngram_embedding.shard_"
+        checkpoint_entries: dict[int, tuple[str, Path]] = {}
+        for checkpoint_name, relative_file in weight_map.items():
+            if not isinstance(checkpoint_name, str) or not isinstance(relative_file, str):
+                continue
+            mapped_name = (
+                name_mapper(checkpoint_name) if name_mapper is not None else checkpoint_name
+            )
+            if mapped_name is None or not mapped_name.startswith(shard_prefix):
+                continue
+            suffix = mapped_name[len(shard_prefix) :]
+            if not suffix.endswith(".weight"):
+                continue
+            shard_text = suffix[: -len(".weight")]
+            if not shard_text.isdigit():
+                continue
+            shard_index = int(shard_text)
+            if shard_index in checkpoint_entries:
+                raise ValueError(f"Duplicate PLE SSD shard index {shard_index}")
+            checkpoint_entries[shard_index] = (
+                checkpoint_name,
+                self.checkpoint_dir / relative_file,
+            )
+
+        expected_indices = set(range(self.expected_parts))
+        found_indices = set(checkpoint_entries)
+        if found_indices != expected_indices:
+            missing = sorted(expected_indices - found_indices)
+            extra = sorted(found_indices - expected_indices)
+            raise ValueError(
+                "PLE SSD checkpoint shard set mismatch: "
+                f"missing={missing}, extra={extra}"
+            )
+
+        headers: dict[Path, tuple[int, dict[str, Any]]] = {}
+        rows_per_shard = (
+            self.expected_vocab_size + self.expected_parts - 1
+        ) // self.expected_parts
+        shards: list[_ShardMetadata] = []
+        for shard_index in range(self.expected_parts):
+            checkpoint_name, file_path = checkpoint_entries[shard_index]
+            if not file_path.is_file():
+                raise FileNotFoundError(
+                    f"PLE SSD shard file is missing for {checkpoint_name}: {file_path}"
+                )
+            if file_path not in headers:
+                headers[file_path] = _read_safetensors_header(file_path)
+            data_base, header = headers[file_path]
+            tensor_info = header.get(checkpoint_name)
+            if not isinstance(tensor_info, dict):
+                raise ValueError(f"Tensor {checkpoint_name} is absent from {file_path}")
+            dtype = tensor_info.get("dtype")
+            shape = tensor_info.get("shape")
+            offsets = tensor_info.get("data_offsets")
+            if dtype != _FP8_DTYPE:
+                raise ValueError(
+                    f"PLE SSD tensor {checkpoint_name} must use {_FP8_DTYPE}, got {dtype}"
+                )
+            if (
+                not isinstance(shape, list)
+                or len(shape) != 2
+                or not all(isinstance(value, int) for value in shape)
+            ):
+                raise ValueError(f"Invalid PLE SSD shape for {checkpoint_name}: {shape}")
+            expected_rows = max(
+                0,
+                min(
+                    rows_per_shard,
+                    self.expected_vocab_size - shard_index * rows_per_shard,
+                ),
+            )
+            expected_shape = [expected_rows, self.embedding_dim]
+            if shape != expected_shape:
+                raise ValueError(
+                    f"PLE SSD shape mismatch for {checkpoint_name}: "
+                    f"expected {expected_shape}, got {shape}"
+                )
+            if (
+                not isinstance(offsets, list)
+                or len(offsets) != 2
+                or not all(isinstance(value, int) for value in offsets)
+            ):
+                raise ValueError(
+                    f"Invalid PLE SSD data offsets for {checkpoint_name}: {offsets}"
+                )
+            relative_start, relative_end = offsets
+            expected_bytes = expected_rows * self.embedding_dim
+            if relative_start < 0 or relative_end - relative_start != expected_bytes:
+                raise ValueError(
+                    f"PLE SSD byte length mismatch for {checkpoint_name}: "
+                    f"expected {expected_bytes}, got {relative_end - relative_start}"
+                )
+            absolute_end = data_base + relative_end
+            if absolute_end > file_path.stat().st_size:
+                raise ValueError(
+                    f"PLE SSD tensor {checkpoint_name} extends past {file_path}"
+                )
+            shards.append(
+                _ShardMetadata(
+                    index=shard_index,
+                    checkpoint_name=checkpoint_name,
+                    file_path=file_path,
+                    data_offset=data_base + relative_start,
+                    rows=expected_rows,
+                    width=self.embedding_dim,
+                )
+            )
+        return shards
+
+    @torch.inference_mode()
+    def lookup(
+        self,
+        indices: torch.Tensor,
+        *,
+        out: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Gather FP8 rows while touching only the referenced file-backed pages."""
+        if indices.device.type != "cpu":
+            raise ValueError("PLE SSD indices must be on CPU")
+        flat_indices = indices.reshape(-1).to(dtype=torch.long)
+        row_count = flat_indices.numel()
+        expected_shape = (row_count, self.embedding_dim)
+        if out is None:
+            output = torch.empty(expected_shape, dtype=self.dtype)
+        else:
+            if out.device.type != "cpu" or out.dtype != self.dtype:
+                raise ValueError(
+                    f"PLE SSD output must be a CPU {self.dtype} tensor, got "
+                    f"{out.device}/{out.dtype}"
+                )
+            if out.numel() < row_count * self.embedding_dim:
+                raise ValueError(
+                    f"PLE SSD output has {out.numel()} elements, needs "
+                    f"{row_count * self.embedding_dim}"
+                )
+            output = out.reshape(-1)[: row_count * self.embedding_dim].reshape(
+                expected_shape
+            )
+        if row_count == 0:
+            return output
+
+        minimum = int(flat_indices.min().item())
+        maximum = int(flat_indices.max().item())
+        if minimum < 0 or maximum >= self.expected_vocab_size:
+            raise IndexError(
+                f"PLE SSD row index outside [0, {self.expected_vocab_size}): "
+                f"min={minimum}, max={maximum}"
+            )
+
+        output_bytes = output.view(torch.uint8)
+        shard_ids = torch.div(
+            flat_indices, self.rows_per_shard, rounding_mode="floor"
+        )
+        order = torch.argsort(shard_ids)
+        sorted_shard_ids = shard_ids.index_select(0, order)
+        unique_shards, counts = torch.unique_consecutive(
+            sorted_shard_ids, return_counts=True
+        )
+        used_files: set[Path] = set()
+        touched_ranges: dict[Path, list[tuple[int, int]]] = {}
+        use_precise_drop = self.drop_cache_after_lookup and row_count <= 1024
+        cursor = 0
+        for shard_index, count in zip(
+            unique_shards.tolist(), counts.tolist(), strict=True
+        ):
+            end = cursor + count
+            output_positions = order[cursor:end]
+            local_rows = flat_indices.index_select(0, output_positions)
+            local_rows.sub_(shard_index * self.rows_per_shard)
+            selected = self._tables[shard_index].index_select(0, local_rows)
+            output_bytes.index_copy_(0, output_positions, selected)
+            file_path = self._table_file_paths[shard_index]
+            used_files.add(file_path)
+            if use_precise_drop:
+                data_offset = self._table_data_offsets[shard_index]
+                touched_ranges.setdefault(file_path, []).extend(
+                    (data_offset + row * self.embedding_dim, self.embedding_dim)
+                    for row in local_rows.tolist()
+                )
+            cursor = end
+
+        if self.drop_cache_after_lookup:
+            if use_precise_drop:
+                for path, ranges in touched_ranges.items():
+                    self._files[path].drop_cache_ranges(ranges)
+            else:
+                for path in used_files:
+                    self._files[path].drop_cache()
+        return output
+
+
+class SsdBackedPleEmbedding(nn.Module):
+    """Weightless embedding placeholder configured after model discovery."""
+
+    def __init__(
+        self,
+        vocab_size: int,
+        embedding_dim: int,
+        split_parts: int,
+    ) -> None:
+        super().__init__()
+        self.org_vocab_size = vocab_size
+        self.embedding_dim = embedding_dim
+        self.split_parts = split_parts
+        self.register_parameter(
+            "weight_scale",
+            nn.Parameter(torch.ones(1, dtype=torch.bfloat16), requires_grad=False),
+        )
+        self._store: SafetensorsPleStore | None = None
+
+    def configure(
+        self,
+        checkpoint_dir: str | os.PathLike[str],
+        layer_prefix: str,
+        *,
+        name_mapper: Callable[[str], str | None] | None,
+        drop_cache: bool,
+    ) -> None:
+        if self._store is not None:
+            raise RuntimeError("PLE SSD embedding is already configured")
+        self._store = SafetensorsPleStore(
+            checkpoint_dir,
+            layer_prefix,
+            expected_parts=self.split_parts,
+            expected_vocab_size=self.org_vocab_size,
+            expected_width=self.embedding_dim,
+            name_mapper=name_mapper,
+            drop_cache=drop_cache,
+        )
+
+    @property
+    def storage_dtype(self) -> torch.dtype:
+        return torch.float8_e4m3fn
+
+    def lookup(self, indices: torch.Tensor, *, out: torch.Tensor) -> torch.Tensor:
+        if self._store is None:
+            raise RuntimeError("PLE SSD embedding was used before checkpoint mapping")
+        return self._store.lookup(indices, out=out)

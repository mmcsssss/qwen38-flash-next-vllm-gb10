+def _configure_cpu_worker() -> None:
+    """Apply optional CPU placement before PyTorch creates worker threads."""
+    affinity_text = os.getenv("QWEN38_PLE_CPU_AFFINITY", "").strip()
+    if affinity_text:
+        if not hasattr(os, "sched_setaffinity"):
+            raise RuntimeError("QWEN38_PLE_CPU_AFFINITY requires Linux affinity APIs")
+        affinity = _parse_cpu_affinity(affinity_text)
+        available = os.sched_getaffinity(0)
+        if not affinity.issubset(available):
+            raise ValueError(
+                "QWEN38_PLE_CPU_AFFINITY requests unavailable CPUs: "
+                f"requested={sorted(affinity)}, available={sorted(available)}"
+            )
+        os.sched_setaffinity(0, affinity)
+        logger.info("Pinned PLE worker to CPU(s): %s", sorted(affinity))
+
